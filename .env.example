# Cacsms Trader environment template.
# Do not put live broker credentials in source control.
#
# Docker Desktop: copy this file to `.env`, then run `npm run docker:up`.
# Dashboard: http://localhost:3000  |  MT5 bridge: http://localhost:8787

APP_URL="http://localhost:3000"
APP_HOST_PORT="3001"
MT5_BRIDGE_HOST_PORT="8787"
CACSMS_ENV="development"
CACSMS_TIMEZONE="Africa/Lagos"
NEXT_PUBLIC_TRADING_MODE="demo"
NEXT_PUBLIC_MT5_BRIDGE_URL="http://localhost:8787"

POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
# When using Docker Compose, Postgres is exposed on host port 5433 by default.
POSTGRES_HOST_PORT="5433"
REDIS_HOST_PORT="6380"
POSTGRES_DB="db_cacsms-trader"
POSTGRES_USER="cacsms"
POSTGRES_PASSWORD="Adm1n.c0m"

REDIS_URL="redis://localhost:6379"

# Live macro/economic data providers. Do not commit production secrets.
TRADING_ECONOMICS_API_KEY=""
TRADING_ECONOMICS_CLIENT=""
TRADING_ECONOMICS_SECRET=""
FRED_API_KEY=""
FINNHUB_API_KEY=""

RISK_DAILY_DRAWDOWN_PERCENT="4"
RISK_MAX_DRAWDOWN_PERCENT="8"
RISK_PER_TRADE_PERCENT="0.5"
RISK_DAILY_TRADE_LIMIT_ENABLED="false"
RISK_MAX_TRADES_PER_DAY="5"
# Open positions: 50% of daily drawdown budget ÷ risk-per-trade (overrides flat RISK_MAX_OPEN_TRADES when computed lower)
RISK_OPEN_EXPOSURE_DRAWDOWN_FRACTION="0.5"
RISK_MAX_OPEN_TRADES="0"
# Daily trades scale with active symbols: tradesPerSymbol × symbolCount
RISK_SYMBOL_BASED_TRADE_LIMIT="true"
RISK_TRADES_PER_SYMBOL_PER_DAY="1"
RISK_MAX_OPEN_TRADES="3"
RISK_MIN_REWARD_RISK_RATIO="2"
RISK_STOP_AFTER_CONSECUTIVE_LOSSES="2"
RISK_MAX_LOT_SIZE="1"
# Emergency halt for all new execution enqueues (env fallback; prefer /api/mt5/execution/kill-switch).
# CACSMS_KILL_SWITCH="false"
# Master execution gate for all trade commands except emergency_close_all.
CACSMS_ENABLE_EXECUTION="false"
# CACSMS_ENABLE_LIVE_EXECUTION="false"
# CACSMS_ENABLE_AUTONOMY_EXECUTION="false"
# Demo pipeline: lower thresholds + auto-dispatch when signal is BUY/SELL.
# CACSMS_PIPELINE_DEMO_MODE="true"
# CACSMS_DEMO_CONFIDENCE_THRESHOLD="42"
# CACSMS_DEMO_DECISION_CONFIDENCE_THRESHOLD="42"
# CACSMS_DEMO_DECISION_READINESS_THRESHOLD="42"
# CACSMS_DEMO_VISUAL_READINESS_THRESHOLD="48"
# CACSMS_ENABLE_LIVE_EXECUTION="false"
# CACSMS_LARGE_EQUITY_THRESHOLD="100000"
# CACSMS_PROP_RISK_PER_TRADE_PERCENT="0.35"
# CACSMS_LIVE_RISK_PER_TRADE_PERCENT="0.25"
# CACSMS_LARGE_EQUITY_RISK_PER_TRADE_PERCENT="0.15"
# CACSMS_DEMO_SIGNAL_COOLDOWN_MINUTES="15"
# CACSMS_DEMO_DISPATCH_COOLDOWN_MINUTES="30"
# CACSMS_AUTONOMY_DEFAULT_LOTS="0.01"
# CACSMS_ENABLE_TRADE_MONITOR="true"
# CACSMS_TRADE_MONITOR_MAX_MINUTES="480"
# CACSMS_TRADE_MONITOR_TRAILING_POINTS="150"
# CACSMS_TRADE_MONITOR_MICRO_BE_R="0.25"
# CACSMS_TRADE_MONITOR_STANDARD_BE_R="0.75"
# CACSMS_TRADE_MONITOR_PROFIT_LOCK_R="1"
# CACSMS_TRADE_MONITOR_PROFIT_LOCK_RETAIN="0.65"
# CACSMS_TRADE_MONITOR_REVERSAL_GIVEBACK="0.8"
# CACSMS_TRADE_MONITOR_MIN_PEAK_PROFIT_USD="0.5"
# CACSMS_TRADE_MONITOR_SPREAD_BUFFER_POINTS="2"
# CACSMS_TRADE_MONITOR_URGENT_COOLDOWN_SEC="12"
# CACSMS_TRADE_MONITOR_NORMAL_COOLDOWN_SEC="45"

MT5_BRIDGE_SHARED_SECRET="mt5_cacsms"
# Optional fallback before a portal-generated secret is applied to the database.
# CACSMS_ENABLE_MT5_BRIDGE_SECRET_TOOL="true"
MT5_BRIDGE_PORT="8787"
MT5_HEARTBEAT_TIMEOUT_MS="15000"

# Set true only if you intentionally expose MT5 dev tools beyond localhost/Docker Desktop.
# CACSMS_TOOLS_ALLOW_REMOTE="false"
# EA deployment (symlink/copy into local MT5 Experts folder). Enabled automatically when CACSMS_ENV=development.
CACSMS_ENABLE_EA_DEPLOYMENT_TOOL="true"
# Set true only if you intentionally expose the EA deployment API beyond localhost.
CACSMS_EA_DEPLOYMENT_ALLOW_REMOTE="false"
# Required for EA deployment inside Docker on Windows (use forward slashes):
# CACSMS_MT5_METAQUOTES_HOST_PATH="C:/Users/YourUser/AppData/Roaming/MetaQuotes"
CACSMS_MT5_METAQUOTES_HOST_PATH=""
CACSMS_AUTO_TEST_MAX_SPREAD_POINTS="100"
CACSMS_AUTO_TEST_DELAY_SECONDS="30"
CACSMS_AUTO_TEST_HEARTBEAT_FRESH_MS="5000"
