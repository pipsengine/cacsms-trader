# Environment
DATABASE_URL=file:./database/db_cacsms-trader.db

# Optional: force writable DB tooling in CI
# DATABASE_WRITABLE=1

# Local MT5 bridge (Python MetaTrader5). Default Vite proxy: /mt5-bridge → 127.0.0.1:8765
# MT5_BRIDGE_HOST=127.0.0.1
# MT5_BRIDGE_PORT=8765
# MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5 IC Markets Global\terminal64.exe
# MT5_AUTO_LAUNCH=1
# VITE_MT5_BRIDGE_URL=/mt5-bridge

# SMTP_APP_PASSWORD=
# SMTP_ENABLED=true
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=pipsengine@gmail.com
# SMTP_FROM_EMAIL=pipsengine@gmail.com
# SMTP_FROM_NAME=PipsEngine Trading System
# TRADING_ALERT_EMAIL=pipsengine@gmail.com
# EMAIL_DELIVERY_MODE=GMAIL
# NOTIFICATION_TIMEZONE=Africa/Lagos
# Use a Google App Password. Never put the normal Gmail password here, and never commit the real .env.
