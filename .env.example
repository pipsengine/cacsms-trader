# Environment
DATABASE_URL=file:./database/cacsms-trader.db

# SQL Server — MT5 account persistence (local)
MSSQL_SERVER=localhost
MSSQL_DATABASE=db_Cacsms-Trader
MSSQL_USER=cascms
MSSQL_PASSWORD=
MSSQL_TRUST_CERT=1
MSSQL_DRIVER=ODBC Driver 18 for SQL Server

# Optional: force writable DB tooling in CI
# DATABASE_WRITABLE=1

# Local MT5 bridge (Python MetaTrader5). Default Vite proxy: /mt5-bridge → 127.0.0.1:8765
# MT5_BRIDGE_HOST=127.0.0.1
# MT5_BRIDGE_PORT=8765
# MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5 IC Markets Global
# VITE_MT5_BRIDGE_URL=/mt5-bridge

# Never put MT5 passwords or API secrets here in plaintext for production.
# Use your host secret manager and store only secret references in SQLite / SQL Server.
