{
  "name": "cacsms-trader",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "db:migrate": "node database/scripts/migrate.mjs",
    "db:seed": "node database/scripts/seed.mjs",
    "db:init": "node database/scripts/init.mjs",
    "db:backup": "node database/scripts/backup.mjs",
    "db:restore": "node database/scripts/restore.mjs",
    "db:health": "node database/scripts/health.mjs",
    "db:test": "node database/scripts/test-crud.mjs",
    "test:aca-ui": "node --test src/features/ai-chart-analysis/production-v4/chartMath.spec.mjs",
    "postinstall": "node database/scripts/postinstall.mjs",
    "mt5:bridge": "node scripts/bridge-supervisor.mjs",
    "mt5:bridge:direct": "py -u bridge/mt5/server.py",
    "mt5:bridge:install": "py -m pip install -r bridge/mt5/requirements.txt",
    "db:runtime:init": "py -c \"from bridge.mt5.db import ensure_database, ensure_schema; ensure_database(); ensure_schema()\""
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "better-sqlite3": "^12.8.0",
    "dotenv": "^17.3.1",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "recharts": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "tsx": "^4.21.0"
  }
}
