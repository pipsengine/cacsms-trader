{
  "name": "cacsms-trader",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "bridge:mt5": "node mt5/bridge/server.mjs",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "next clean",
    "docker:up": "npm run build && docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app",
    "docker:migrate": "node scripts/apply-all-migrations.mjs",
    "cot:sync": "npx tsx --tsconfig tsconfig.json scripts/cot-sync-host.ts last-2-years",
    "cot:sync:latest": "npx tsx --tsconfig tsconfig.json scripts/cot-sync-host.ts latest",
    "calendar:discover": "npx tsx --tsconfig tsconfig.json scripts/economic-calendar-discover-host.ts discover",
    "calendar:refresh": "npx tsx --tsconfig tsconfig.json scripts/economic-calendar-discover-host.ts refresh"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@google/genai": "^1.17.0",
    "@hookform/resolvers": "^5.2.1",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.2.1",
    "fflate": "^0.8.2",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "next": "^15.4.9",
    "pg": "^8.21.0",
    "playwright": "^1.55.0",
    "postcss": "^8.5.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "recharts": "^3.8.1",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.6.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.11",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.8",
    "firebase-tools": "^15.0.0",
    "tailwindcss": "4.1.11",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  }
}
